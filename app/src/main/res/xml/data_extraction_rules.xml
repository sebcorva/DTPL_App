<?xml version="1.0" encoding="utf-8"?>
<!-- ISSUE-40: Android 12+. Nada de la app (nombres, GPS, fotos, base de datos) se respalda en la
     nube de Google ni se copia al pasar a un teléfono nuevo. Los datos viven solo en el teléfono
     hasta que se sincronizan con Supabase. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
